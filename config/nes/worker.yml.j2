logLevel: LOG_ERROR
localWorkerHost: {{ nes_worker_host_ip }}
coordinatorHost: {{ nes_coordinator_host_ip }}
#numWorkerThreads: 8
numberOfBuffersInGlobalBufferManager: 4096
numberOfBuffersInSourceLocalBufferPool: 1024
bufferSizeInBytes: 262144
numberOfSlots: 2

queryCompiler:
  maxHashTableSize: 2147483648
  joinStrategy: HASH_JOIN_LOCAL
  numberOfPartitions: 1000
  preAllocPageCnt: 32
  pageSize: 65536

{% if include_source | default(false) | bool %}
physicalSources:
    - logicalSourceName: bids
      physicalSourceName: bids_1
      type: TCP_SOURCE
      configuration:
        socketHost: {{ nes_source_socket_host_ip }}
        socketPort: 10000
        decideMessageSize: BUFFER_SIZE_FROM_SOCKET
        bytesUsedForSocketBufferSizeTransfer: 4
        inputFormat: FE2C_BINARY

    - logicalSourceName: auctions
      physicalSourceName: auctions_1
      type: TCP_SOURCE
      configuration:
        socketHost: {{ nes_source_socket_host_ip }}
        socketPort: 10001
        decideMessageSize: BUFFER_SIZE_FROM_SOCKET
        bytesUsedForSocketBufferSizeTransfer: 4
        inputFormat: FE2C_BINARY

    - logicalSourceName: persons
      physicalSourceName: persons_1
      type: TCP_SOURCE
      configuration:
        socketHost: {{ nes_source_socket_host_ip }}
        socketPort: 10002
        decideMessageSize: BUFFER_SIZE_FROM_SOCKET
        bytesUsedForSocketBufferSizeTransfer: 4
        inputFormat: FE2C_BINARY
{% endif %}

# parentId: 1
