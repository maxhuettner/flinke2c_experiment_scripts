[Interface]
PrivateKey = {{ iface.private_key }}
Address = {{ iface.address }}
ListenPort = {{ iface.listen_port }}
MTU = {{ iface.mtu | default(wireguard_default_mtu | default(1420)) }}
# Table=off: disable wg-quick's iptables/fwmark management entirely.
# It calls iptables-restore internally even without PostUp hooks, which hangs
# on fresh Ubuntu 22.04 EC2 instances.  Routes are managed via ip-route below.
Table = off
{% set up_cmds = [] %}
{% set dn_cmds = [] %}
{% set src_hint = '' %}
{% if iface.node_address is defined and iface.node_address %}
{% set src_hint = ' src ' + iface.node_address %}
{% endif %}
{% for peer in iface.peers | default([]) %}
{% for ip in peer.direct_routes | default([]) %}
{% if up_cmds.append('ip route replace ' + ip + src_hint + ' dev %i') %}{% endif %}
{% if dn_cmds.append('ip route del ' + ip + ' dev %i || true') %}{% endif %}
{% endfor %}
{% endfor %}
{% if iface.speed %}
{% if up_cmds.append('tc qdisc replace dev %i root tbf rate ' + iface.speed|string + 'mbit burst 64kb latency 50ms') %}{% endif %}
{% endif %}
{% if up_cmds %}
PostUp  = {{ up_cmds | join('; ') }}
PreDown = {{ dn_cmds | join('; ') }}
{% endif %}

{% for peer in iface.peers | default([]) %}
[Peer]
PublicKey = {{ peer.public_key }}
AllowedIPs = {{ peer.allowed_ips if peer.allowed_ips is string else peer.allowed_ips | join(', ') }}
{% if peer.endpoint is defined %}
Endpoint = {{ peer.endpoint }}
{% endif %}
{% if peer.persistent_keepalive is defined %}
PersistentKeepalive = {{ peer.persistent_keepalive }}
{% endif %}

{% endfor %}
