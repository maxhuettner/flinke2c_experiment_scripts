[Unit]
Description=WireGuard ECMP Routes
# Must start after every wg-quick interface so the nexthop devices are present.
# PartOf= ensures this service is restarted whenever any wg-quick interface restarts.
{% set wg_units = wireguard_interfaces | map(attribute='interface') | map('regex_replace', '^(.*)$', 'wg-quick@\\1.service') | list %}
After=network.target{% if wg_units %} {{ wg_units | join(' ') }}{% endif %}
{% if wg_units %}
PartOf={{ wg_units | join(' ') }}
{% endif %}

[Service]
Type=oneshot
ExecStart=/etc/wireguard/apply-ecmp-routes.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
