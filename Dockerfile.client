FROM rust:1.90 AS builder

WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY exp_management/Cargo.toml exp_management/Cargo.toml
COPY resource_management/Cargo.toml resource_management/Cargo.toml

COPY exp_management/src exp_management/src
COPY resource_management/src resource_management/src
COPY config ./config

RUN cargo build --release -p exp_management


FROM debian:bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/target/release/exp_management /usr/local/bin/exp_management
COPY config ./config

CMD ["exp_management"]
